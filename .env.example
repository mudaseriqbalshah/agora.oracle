# ─── Hedera Testnet Credentials ───────────────────────────────────────────────
# Get these from https://portal.hedera.com (free testnet account)
HEDERA_OPERATOR_ID=0.0.XXXXXXX
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420...

# ─── UCP HCS Topics (populated after running: npm run setup) ──────────────────
HCS_TOPIC_UCP_INTENTS=        # Agent buy/sell intent messages
HCS_TOPIC_ORACLE_PRICES=      # openBridge oracle price attestations
HCS_TOPIC_SETTLEMENTS=        # Completed trade records
HCS_TOPIC_REPUTATION=         # Agent reputation updates

# ─── HTS Token IDs (populated after running: npm run setup) ──────────────────
HTS_WHEAT_TOKEN=              # Tokenized wheat commodity
HTS_USD_TOKEN=                # USD stablecoin for settlement

# ─── Agent Accounts (separate testnet accounts for Alice and Bob) ─────────────
AGENT_ALICE_ID=0.0.XXXXXXX
AGENT_ALICE_KEY=302e...
AGENT_BOB_ID=0.0.XXXXXXX
AGENT_BOB_KEY=302e...

# ─── Oracle Node ──────────────────────────────────────────────────────────────
ORACLE_NODE_ID=0.0.XXXXXXX
ORACLE_NODE_KEY=302e...
